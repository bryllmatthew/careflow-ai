# CareFlow AI — environment template
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# From: Supabase Dashboard → Project Settings → API
# For local development (`supabase start`), use the values the CLI prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely.
# Used ONLY by supabase/ migrations and scripts/ admin tooling — never on a request path.
# An ESLint rule enforces this; see CLAUDE.md → "Non-negotiable security rules".
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for migrations and the pgTAP authorization suite.
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI (Phase 9)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Messaging (Phase 4) — leave the driver as `console` until a vendor is chosen.
# ---------------------------------------------------------------------------
MESSAGING_DRIVER=console
RESEND_API_KEY=
SMS_API_KEY=

# ---------------------------------------------------------------------------
# Payments (Phase 6) — manual recording needs no provider.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=manual
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Cron (Phase 4) — shared secret so only Vercel Cron can invoke /api/cron/*
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
